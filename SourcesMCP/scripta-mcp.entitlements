<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed (spawned by LLM clients, so it can't inherit a sandbox) — but it
	     shares the app's group container to read the index + state file without prompts. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>6CTH5M9UWZ.com.ronanwood.calltranscriber</string>
	</array>
</dict>
</plist>

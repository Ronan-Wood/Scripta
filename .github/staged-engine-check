#!/usr/bin/env python3
"""The engine's staged `.github` must say what this repository's says about the engine.

`substrate/.github/` goes live when the engine is its own repository. Until then this repository's
`.github` runs the engine's jobs and covers its dependencies, so the two must not drift. Both are
read as YAML 1.2, as GitHub reads them (`ruamel.yaml`, from the engine's locked `test` group), and
compared as parsed data, types included, so comments and layout do not matter and meaning does.

- `dependabot.yml`: the same, but that the staged `github-actions` and `uv` entries are this
  repository's `github-actions` entry at `/` and `uv` entry at `/substrate`, with the directory
  moved to `/`. This repository's other entries are its own.
- The workflows: each staged job is the job here it copies, step for step, and each staged
  workflow is the one here outside its jobs. Exempt, each only as an exact value:
  - a workflow's `name`, triggers (`on`) and `concurrency`;
  - the step that puts the engine on `PYTHONPATH`: here exactly `SETUP_HERE`, staged exactly
    `SETUP_STAGED`, each a step with nothing but that `run`;
  - here, a step's `working-directory` of exactly `WORKDIR_HERE`, where that copy is.
  Dependabot bumps the pins here only, so a bump the staged copy has not taken fails this. Every
  staged workflow and job must be one of these copies.

usage: .github/staged-engine-check [ROOT_GITHUB STAGED_GITHUB]
"""
from __future__ import annotations

import difflib
import json
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

# (workflow, job) here -> (workflow, job) staged.
JOBS = {
    ("tests.yml", "engine"): ("tests.yml", "engine"),
    ("tests.yml", "docling"): ("docling.yml", "docling"),
    ("codeql.yml", "python"): ("codeql.yml", "python"),
}
# Dependabot: (ecosystem, directory) staged -> (ecosystem, directory) here.
ENTRIES = {("github-actions", "/"): ("github-actions", "/"), ("uv", "/"): ("uv", "/substrate")}
OWN = ("name", "on", "concurrency")
SETUP_HERE = {"run": 'bash .github/engine-alone "$RUNNER_TEMP/engine"\n'
                     'echo "PYTHONPATH=$RUNNER_TEMP/engine" >> "$GITHUB_ENV"\n'}
SETUP_STAGED = {"run": 'echo "PYTHONPATH=$GITHUB_WORKSPACE" >> "$GITHUB_ENV"'}
SETUP = "(the step that puts the engine on PYTHONPATH)"
WORKDIR_HERE = "${{ runner.temp }}/engine"


class Wrong(Exception):
    pass


def load(path: Path) -> dict:
    from ruamel.yaml import YAML
    from ruamel.yaml.error import YAMLError

    try:
        data = YAML(typ="safe", pure=True).load(path.read_text(encoding="utf-8"))
    except OSError as unreadable:
        raise Wrong(f"{path} cannot be read: {unreadable.strerror}") from None
    except YAMLError as invalid:
        raise Wrong(f"{path} is not valid YAML: {invalid}") from None
    if not isinstance(data, dict):
        raise Wrong(f"{path} is not a YAML mapping")
    return data


def same(a: object, b: object) -> bool:
    """Equal as parsed YAML, types included: Python's `True == 1` is not GitHub's."""
    if type(a) is not type(b):
        return False
    if isinstance(a, dict):
        return a.keys() == b.keys() and all(same(a[k], b[k]) for k in a)
    if isinstance(a, list):
        return len(a) == len(b) and all(same(x, y) for x, y in zip(a, b))
    return a == b


def _diff(a: object, b: object) -> str:
    def lines(value: object) -> list[str]:
        return json.dumps(value, indent=2, sort_keys=True, default=repr).splitlines()

    return "".join(f"\n    {line}" for line in
                   difflib.unified_diff(lines(a), lines(b), "here", "staged", lineterm=""))


def dependabot(root: Path, staged: Path) -> list[str]:
    def entries(path: Path, data: dict) -> dict[tuple[str, str], dict]:
        found: dict[tuple[str, str], dict] = {}
        for entry in data.get("updates") or []:
            if not isinstance(entry, dict) or "directory" not in entry:
                raise Wrong(f"{path} has an update without one `directory`: {entry!r}")
            key = (str(entry.get("package-ecosystem")), str(entry["directory"]))
            if key in found:
                raise Wrong(f"{path} has two {key[0]} entries at {key[1]}")
            found[key] = {k: v for k, v in entry.items() if k != "directory"}
        return found

    here, there = load(root), load(staged)
    mine, theirs = entries(root, here), entries(staged, there)
    wrong = []
    rest = [{k: v for k, v in doc.items() if k != "updates"} for doc in (here, there)]
    if not same(*rest):
        wrong.append(f"{root} and {staged} differ outside their entries:" + _diff(*rest))
    if set(theirs) != set(ENTRIES):
        wrong.append(f"{staged} has {sorted(theirs)}; it must have exactly {sorted(ENTRIES)}")
    for key, source in ENTRIES.items():
        if source not in mine:
            wrong.append(f"{root} has no {source[0]} entry at {source[1]}")
        elif key in theirs and not same(mine[source], theirs[key]):
            wrong.append(f"the {key[0]} Dependabot entries differ:" + _diff(mine[source], theirs[key]))
    return wrong


def _steps(steps: object, setup: dict, workdir: str | None) -> object:
    """The steps with the setup step, matched exactly, replaced by SETUP, and the given
    `working-directory` left out wherever it is exactly that."""
    if not isinstance(steps, list):
        return steps
    out = []
    for step in steps:
        if same(step, setup):
            out.append(SETUP)
        elif isinstance(step, dict) and workdir is not None and same(step.get("working-directory"), workdir):
            out.append({k: v for k, v in step.items() if k != "working-directory"})
        else:
            out.append(step)
    return out


def workflows(root: Path, staged: Path) -> list[str]:
    wrong = []
    copies: dict[str, set[str]] = {}
    for copy, copied in JOBS.values():
        copies.setdefault(copy, set()).add(copied)
    present = {p.name for p in staged.glob("*.y*ml")}
    if present != set(copies):
        wrong.append(f"{staged} has the workflows {sorted(present)}; it must have exactly {sorted(copies)}")
    loaded: dict[Path, dict] = {}

    def doc(path: Path) -> dict:
        if path not in loaded:
            loaded[path] = load(path)
        return loaded[path]

    def jobs(path: Path) -> dict:
        found = doc(path).get("jobs")
        return found if isinstance(found, dict) else {}

    for copy, wanted in copies.items():
        if copy in present and set(jobs(staged / copy)) != wanted:
            wrong.append(f"the staged {copy} has the jobs {sorted(jobs(staged / copy))}; "
                         f"it must have exactly {sorted(wanted)}")
    for (workflow, job), (copy, copied) in JOBS.items():
        if copy not in present:
            continue
        here, there = jobs(root / workflow).get(job), jobs(staged / copy).get(copied)
        if not isinstance(here, dict) or not isinstance(there, dict):
            wrong.append(f"there is no job {workflow} {job}" if not isinstance(here, dict)
                         else f"there is no job staged {copy} {copied}")
            continue
        a = {**here, "steps": _steps(here.get("steps"), SETUP_HERE, WORKDIR_HERE)}
        b = {**there, "steps": _steps(there.get("steps"), SETUP_STAGED, None)}
        if not same(a, b):
            wrong.append(f"{workflow} {job} and the staged {copy} {copied} differ:" + _diff(a, b))
        rest = [{k: v for k, v in doc(path).items() if k not in OWN and k != "jobs"}
                for path in (root / workflow, staged / copy)]
        if not same(*rest):
            wrong.append(f"{workflow} and the staged {copy} differ outside their jobs:" + _diff(*rest))
    return wrong


def main(argv: list[str]) -> int:
    if len(argv) not in (0, 2):
        sys.exit(__doc__.strip().splitlines()[-1])
    root, staged = (Path(a) for a in argv) if argv else (REPO / ".github", REPO / "substrate/.github")
    wrong = []
    for check, a, b in ((dependabot, root / "dependabot.yml", staged / "dependabot.yml"),
                        (workflows, root / "workflows", staged / "workflows")):
        try:
            wrong += check(a, b)
        except Wrong as failure:
            wrong.append(str(failure))
    for line in wrong:
        print(f"staged-engine-check: {line}", file=sys.stderr)
    if not wrong:
        print(f"staged-engine-check: {staged} matches {root}")
    return 1 if wrong else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

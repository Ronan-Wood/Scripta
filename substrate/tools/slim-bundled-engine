#!/usr/bin/env bash
# Delete what the bundled engine carries and never runs. `build-bundled-engine` calls this on its
# stage BEFORE the import checks and the signing pass, then again with `--check` after signing.
#
#   slim-bundled-engine <engine-root>           delete
#   slim-bundled-engine --check <engine-root>   refuse if any of it is present, or if any file
#                                               carries a code signature in its extended attributes
#
# macOS only: the check uses BSD `find -xattrname`, and the tree it reads is only ever built there.
#
# WHY THIS EXISTS. Sparkle refuses to diff a tree in which any file carries `com.apple.cs.*` extended
# attributes (`Autoupdate/SUBinaryDeltaCreate.m`, before-tree OR after-tree), and 0.3.0 and 0.3.2
# each shipped 142 of them: the DWARF files inside `.dSYM` bundles. `file` reports those as Mach-O,
# so the signing pass signed them, and codesign — which cannot embed a signature in a dSYM companion —
# wrote it into xattrs instead. No delta could be built, so every update was the full dmg.
#
# Measured on the 0.3.2 engine (1,232 MB raw, ~320 MB gzipped), what goes:
#
#   .dSYM bundles, 142 — 140 are ALL of `PyObjCTest`, 2 sit in `objc`    23.7 MB    7.3 MB gz
#   torch/include, C++ headers for building extensions                    62.5 MB    5.5 MB gz
#   the interpreter's Tcl/Tk, tkinter, IDLE, turtledemo, ensurepip,       23.5 MB    7.8 MB gz
#     pip and C headers
#
# Nothing here imports `PyObjCTest` (it held nothing but debug symbols), the engine never calls
# `torch.compile` or `torch.utils.cpp_extension`, only `_tkinter` links Tcl/Tk, and only `tqdm.tk`
# imports tkinter. The venv was created before this runs, so the interpreter's pip and ensurepip have
# already done their only job; the venv does not see the interpreter's own site-packages
# (`include-system-site-packages = false`).
#
# WHAT STAYS, ON PURPOSE:
#   - `__pycache__`, 254 MB raw. It is the biggest class and it is load-bearing: importing torch,
#     docling, transformers, scipy and pandas took 2.9 s warm with it and 6.7–8.4 s without, on every
#     ingest the app starts. The shims run `-B`, so nothing would rewrite it either.
#   - `testing/` packages (numpy, torch, pandas, sympy). Their parent packages import them.
set -euo pipefail

die() { echo "slim-bundled-engine: $*" >&2; exit 1; }

CHECK=
if [ "${1:-}" = "--check" ]; then CHECK=1; shift; fi
[ $# -eq 1 ] || die "usage: $0 [--check] <engine-root>"
ROOT=$1
while [ "${ROOT%/}" != "$ROOT" ]; do ROOT=${ROOT%/}; done
[ -d "$ROOT/.venv" ] && [ -d "$ROOT/runtime" ] || die "'$ROOT' is not an engine tree (no .venv/ or runtime/)"

# Globs, because the interpreter's minor version and Tcl's are both in these names. One that matches
# nothing stays literal and fails the `-e` test, so a class this tree does not have is skipped.
unneeded() {
  find "$ROOT" -type d -name '*.dSYM' -prune -print
  local p
  for p in \
    "$ROOT"/.venv/lib/python3.*/site-packages/PyObjCTest \
    "$ROOT"/.venv/lib/python3.*/site-packages/torch/include \
    "$ROOT"/runtime/include \
    "$ROOT"/runtime/lib/tcl[0-9]* "$ROOT"/runtime/lib/tk[0-9]* \
    "$ROOT"/runtime/lib/itcl[0-9]* "$ROOT"/runtime/lib/thread[0-9]* \
    "$ROOT"/runtime/lib/libtcl* "$ROOT"/runtime/lib/libtk* \
    "$ROOT"/runtime/lib/python3.*/tkinter "$ROOT"/runtime/lib/python3.*/idlelib \
    "$ROOT"/runtime/lib/python3.*/turtledemo "$ROOT"/runtime/lib/python3.*/ensurepip \
    "$ROOT"/runtime/lib/python3.*/lib-dynload/_tkinter.* \
    "$ROOT"/runtime/lib/python3.*/site-packages/pip \
    "$ROOT"/runtime/lib/python3.*/site-packages/pip-*.dist-info \
    "$ROOT"/runtime/bin/idle3* "$ROOT"/runtime/bin/pip*; do
    if [ -e "$p" ] || [ -L "$p" ]; then printf '%s\n' "$p"; fi
  done
}

if [ -n "$CHECK" ]; then
  left=$(unneeded)
  [ -z "$left" ] || die "the engine still carries what it never runs:
$left"
  # The three Sparkle names, and only those. Every file also carries `com.apple.provenance`, which
  # the OS writes, `xattr -c` cannot remove, and Sparkle does not read.
  signed=$(find "$ROOT" -xattrname com.apple.cs.CodeDirectory -o -xattrname com.apple.cs.CodeRequirements \
    -o -xattrname com.apple.cs.CodeSignature)
  [ -z "$signed" ] || die "files carry a code signature in extended attributes, so Sparkle cannot build a delta:
$signed"
  exit 0
fi

before=$(du -sk "$ROOT" | cut -f1)
count=0
while IFS= read -r p; do
  rm -rf "$p"
  count=$((count + 1))
done < <(unneeded)
after=$(du -sk "$ROOT" | cut -f1)
echo "  removed $count paths the engine never runs ($(( (before - after) / 1024 )) MB)"

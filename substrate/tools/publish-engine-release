#!/usr/bin/env python3
"""Publish an engine release: the source tarball of a signed, pushed tag, and its SHA256SUMS.

usage: tools/publish-engine-release [--dry-run] vX.Y.Z[-rc.N]

`RELEASING.md` is the runbook: make a signed tag on `main`, push it, then run this. It refuses
unless all of these hold, and checks them before it writes anything:

- it runs in the engine's own repository, with this tree at the repository's root;
- the tag is `vX.Y.Z` or `vX.Y.Z-rc.N`, and `pyproject.toml` at the tag holds that version
  (`X.Y.Z`, or `X.Y.ZrcN`);
- the tag exists here, is annotated, and GitHub holds the same tag object, on the same commit,
  with a signature it verifies;
- that commit is on GitHub's `main`: it is `main` or an ancestor of it, not a commit pushed with
  the tag alone.

Then it writes `dist/substrate-<version>.tar.gz` with `git archive` and checks it against the
commit byte for byte, writes `dist/SHA256SUMS`, and creates the GitHub release with both
(`--verify-tag`; a pre-release for an `-rc` tag, and Latest only when it is newer than GitHub's
current Latest). It refuses a tag that already has a release. `--dry-run` does every check and
writes both files, prints them, and stops before the release.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import subprocess
import sys
import tarfile
from pathlib import Path

REPO = "Ronan-Wood/substrate"
ROOT = Path(__file__).resolve().parent.parent
NUMBER = r"(0|[1-9][0-9]*)"
TAG = re.compile(rf"v{NUMBER}\.{NUMBER}\.{NUMBER}(?:-rc\.([1-9][0-9]*))?", re.ASCII)


class Refused(Exception):
    pass


# An inherited repository (git exports these to hooks, and wrappers can) would point every command
# below at another repository than this tree's.
INHERITED = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
             "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_COMMON_DIR")


def git(*args: str) -> str:
    # A replace ref would let the archive and the tree it is checked against agree on another
    # commit's files under this one's id.
    env = {k: v for k, v in os.environ.items() if k not in INHERITED}
    env["GIT_NO_REPLACE_OBJECTS"] = "1"
    run = subprocess.run(["git", *args], cwd=ROOT, env=env, capture_output=True, text=True,
                         errors="surrogateescape")
    if run.returncode:
        raise Refused(f"git {' '.join(args)}: {run.stderr.strip() or 'failed'}")
    return run.stdout


def gh_json(path: str) -> dict:
    run = subprocess.run(["gh", "api", path], cwd=ROOT, capture_output=True, text=True)
    if run.returncode:
        raise Refused(f"gh api {path} failed: {run.stderr.strip() or 'no message'}")
    try:
        answer = json.loads(run.stdout)
    except ValueError:
        answer = None
    if not isinstance(answer, dict):
        raise Refused(f"gh api {path} did not answer with a JSON object")
    return answer


def gh_has(path: str) -> bool:
    """Whether `gh api` finds `path`: a 404 is False, anything else that fails is a refusal."""
    run = subprocess.run(["gh", "api", path], cwd=ROOT, capture_output=True, text=True)
    if run.returncode and "HTTP 404" in run.stderr:
        return False
    if run.returncode:
        raise Refused(f"gh api {path} failed: {run.stderr.strip() or 'no message'}")
    return True


def sha(answer: dict) -> object:
    """`object.sha` of a git ref or tag answer, or None when the answer has no such thing."""
    target = answer.get("object")
    return target.get("sha") if isinstance(target, dict) else None


def is_latest(tag: str) -> bool:
    """Whether `tag` is newer than GitHub's current Latest release. GitHub makes every new release
    Latest unless told otherwise, so a patch on an older line must say it is not."""
    if not gh_has(f"repos/{REPO}/releases/latest"):
        return True
    current = gh_json(f"repos/{REPO}/releases/latest").get("tag_name")
    match = TAG.fullmatch(current) if isinstance(current, str) else None
    if not match:
        raise Refused(f"GitHub's Latest release is {current!r}, not a release tag, so there is no "
                      "telling whether this one is newer")
    def order(found: re.Match) -> tuple[int, ...]:
        major, minor, patch, rc = found.groups()
        # A release outranks its own release candidates.
        return int(major), int(minor), int(patch), int(rc) if rc else sys.maxsize

    return order(TAG.fullmatch(tag)) > order(match)


def version_of(tag: str) -> str:
    match = TAG.fullmatch(tag)
    if not match:
        raise Refused(f"{tag!r} is not a release tag: vX.Y.Z or vX.Y.Z-rc.N")
    major, minor, patch, rc = match.groups()
    return f"{major}.{minor}.{patch}" + (f"rc{rc}" if rc else "")


def project_version(pyproject: str) -> str | None:
    """`version` in `[project]`, read by line: this runs on a Python without `tomllib`."""
    table = None
    for line in pyproject.splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            table = stripped.split("#", 1)[0].strip()
        elif table == "[project]":
            found = re.fullmatch(r"""version\s*=\s*(["'])([^"']*)\1\s*(#.*)?""", stripped)
            if found:
                return found.group(2)
    return None


def check_tag(tag: str) -> tuple[str, str]:
    """`(tag object, commit)`, once the tag here is GitHub's, signed and verified."""
    toplevel = Path(git("rev-parse", "--show-toplevel").strip()).resolve()
    if toplevel != ROOT:
        raise Refused(f"this tree is not a repository's root: run this in the engine's own "
                      f"repository, not inside {toplevel}")
    try:
        local = git("rev-parse", "-q", "--verify", f"refs/tags/{tag}").strip()
    except Refused:
        local = ""
    if not local:
        raise Refused(f"there is no tag {tag} here: make it signed (`git tag -s`) and push it")
    if git("cat-file", "-t", local).strip() != "tag":
        raise Refused(f"{tag} is a lightweight tag; a release tag is annotated and signed")
    commit = git("rev-parse", f"{local}^{{commit}}").strip()
    theirs = sha(gh_json(f"repos/{REPO}/git/ref/tags/{tag}"))
    if theirs != local:
        raise Refused(f"GitHub's {tag} is {theirs}, this one is {local}: "
                      "push the tag, and never move one that is already pushed")
    remote = gh_json(f"repos/{REPO}/git/tags/{local}")
    if sha(remote) != commit:
        raise Refused(f"GitHub's {tag} names {sha(remote)}, not {commit}")
    verification = remote.get("verification")
    verification = verification if isinstance(verification, dict) else {}
    if verification.get("verified") is not True:
        raise Refused(f"GitHub does not verify {tag}'s signature "
                      f"({verification.get('reason', 'no verification')}): sign it with a key "
                      "GitHub knows")
    # A pushed tag carries its commit with it, past `main`'s rules: release only what `main` holds.
    # The branch by its full ref, then compared by id: a tag named `main` would shadow the name.
    main = sha(gh_json(f"repos/{REPO}/git/ref/heads/main"))
    if not isinstance(main, str):
        raise Refused(f"GitHub's refs/heads/main is {main!r}, not a commit")
    behind = gh_json(f"repos/{REPO}/compare/{commit}...{main}").get("status")
    if behind not in ("identical", "ahead"):
        raise Refused(f"{tag}'s commit {commit} is not on GitHub's main ({behind}): "
                      "tag a commit that merged")
    return local, commit


def check_archive(path: Path, prefix: str, commit: str) -> None:
    """THE TARBALL IS THE COMMIT, byte for byte. `git archive` applies attributes and config, the
    clone's and the user's as well as the commit's own `.gitattributes`, so every file is checked
    against the commit's blob and mode, and none may be missing or extra."""
    algorithm = git("rev-parse", "--show-object-format").strip()
    want = {}
    for entry in git("ls-tree", "-r", "-z", commit).split("\0"):
        if entry:
            meta, name = entry.split("\t", 1)
            mode, _, oid = meta.split(" ")
            want[name] = (mode, oid)
    got = {}
    try:
        with tarfile.open(path, "r:gz") as tar:
            members = [(m, tar.extractfile(m).read() if m.isfile() else b"") for m in tar]
    except (tarfile.TarError, EOFError, OSError) as unreadable:
        raise Refused(f"{path.name} does not read as a gzipped tar: {unreadable}") from None
    for member, content in members:
        if member.isdir():
            continue
        name = member.name[len(prefix):] if member.name.startswith(prefix) else "/" + member.name
        if member.isfile():
            data, mode = content, "100755" if member.mode & 0o100 else "100644"
        elif member.issym():
            data, mode = member.linkname.encode("utf-8", "surrogateescape"), "120000"
        else:
            data, mode = b"", f"type {member.type!r}"
        got[name] = (mode, hashlib.new(algorithm, b"blob %d\0" % len(data) + data).hexdigest())
    wrong = sorted(n for n in want.keys() | got.keys() if want.get(n) != got.get(n))
    if wrong:
        shown = "".join(f"\n  {n}: commit {want.get(n)}, tarball {got.get(n)}" for n in wrong[:20])
        raise Refused(f"{path.name} is not {commit} byte for byte ({len(wrong)} files):{shown}")


def publish(tag: str, dry_run: bool) -> list[Path]:
    version = version_of(tag)
    local, commit = check_tag(tag)
    pinned = project_version(git("show", f"{commit}:pyproject.toml"))
    if pinned != version:
        raise Refused(f"pyproject.toml at {tag} says version {pinned!r}, and {tag} is {version}")
    if gh_has(f"repos/{REPO}/releases/tags/{tag}"):
        raise Refused(f"GitHub already has a release for {tag}; a pushed tag is never released twice")
    # Decided with the other checks, before anything is written, so a dry run says it too.
    latest = None if "rc" in version else is_latest(tag)

    dist = ROOT / "dist"
    dist.mkdir(exist_ok=True)
    tarball = dist / f"substrate-{version}.tar.gz"
    sums = dist / "SHA256SUMS"
    partial = tarball.with_name(tarball.name + ".partial")
    for stale in (tarball, sums, partial):
        stale.unlink(missing_ok=True)
    prefix = f"substrate-{version}/"
    try:
        git("archive", "--format=tar.gz", f"--prefix={prefix}", "-o", str(partial), commit)
        check_archive(partial, prefix, commit)
    except BaseException:
        partial.unlink(missing_ok=True)
        raise
    partial.rename(tarball)
    digest = hashlib.sha256(tarball.read_bytes()).hexdigest()
    sums.write_text(f"{digest}  {tarball.name}\n", encoding="utf-8")

    assets = [tarball, sums]
    if dry_run:
        kind = "a pre-release" if latest is None else "Latest" if latest else "not Latest"
        print(f"publish-engine-release: dry run; {tag} at {commit}, {kind}, would carry:",
              file=sys.stderr)
        for asset in assets:
            print(asset.relative_to(ROOT))
        return assets

    release = ["gh", "release", "create", tag, *(str(a) for a in assets), "--repo", REPO,
               "--verify-tag", "--title", f"substrate {tag}",
               "--notes", f"The source of substrate {tag}, with its SHA256SUMS."]
    if latest is None:
        release.append("--prerelease")
    else:
        release.append("--latest" if latest else "--latest=false")
    if subprocess.run(release, cwd=ROOT).returncode:
        raise Refused(f"gh release create failed. The tag is unchanged; if GitHub made a release "
                      f"{tag} anyway, delete it before running this again")
    # GitHub resolved the tag again to make the release. The tarball is of what it held before.
    try:
        after = sha(gh_json(f"repos/{REPO}/git/ref/tags/{tag}"))
    except Refused as unchecked:
        raise Refused(f"the release {tag} was made, but its tag could not be checked again: "
                      f"{unchecked}") from None
    if after != local:
        raise Refused(f"GitHub's {tag} changed while the release was made (now {after}): the release "
                      "names it, and its tarball is of the commit the tag named before. Delete the "
                      "release")
    return assets


def main(argv: list[str]) -> int:
    dry_run = argv[:1] == ["--dry-run"]
    args = argv[1:] if dry_run else argv
    if len(args) != 1 or args[0].startswith("-"):
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 2
    try:
        publish(args[0], dry_run)
    except Refused as refused:
        print(f"publish-engine-release: {refused}", file=sys.stderr)
        return 1
    except FileNotFoundError as missing:
        if missing.filename not in ("git", "gh"):
            raise
        print(f"publish-engine-release: {missing.filename} is not installed or not on PATH",
              file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

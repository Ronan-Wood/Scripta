.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Ingestion outputs. Regenerable from the PDFs + a pinned extractor; the run that matters
# gets its document.md committed deliberately once the emitter lands (it is the diffable
# regression artifact), not swept in as scratch.
out/

# eval baseline — local, derived from the corpus; regenerate with ./run.sh --update-baseline
eval/.baseline.json

# durable vector cache — expensive to regenerate, content-addressed so never stale
out/vector-cache.db*

# Derived index for the Doc-2 vault spike. Disposable, rebuilt from vaults/ markdown; kept
# OUT of the eval's out/ so it can never disturb out/substrate.db. The vaults/ source is tracked.
out-vault/

# SQLite WAL sidecars — PROCESS STATE, not data, and they were tracked (all four: substrate.db
# and vectors.db). A committed `-shm` is a snapshot of one process's shared-memory index, so it
# is stale for every later reader; a committed `-wal` is worse, because a stale WAL over an
# already-checkpointed database is a claim about uncommitted transactions that no longer exist.
# The .db files beside them stay tracked — those are the data.
*.db-shm
*.db-wal

bin/
